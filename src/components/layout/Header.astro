---
const navItems = [
  { name: 'Inicio', href: '/' },
  { name: 'Nuestra Historia', href: '/nosotros' },
  { name: 'Productos', href: '/productos' },
  { name: 'Blog', href: '/blog' },
  { name: 'Contáctanos', href: '/contacto' },
];
---

<!-- Top bar -->
<div class="top-bar py-1">
  <div class="top-bar-inner">
    {Array(12).fill('Paquetes especiales para Empresas').map((text) => (
      <span>{text}</span>
    ))}
  </div>
</div>

<nav class="navbar navbar-expand-lg navbar-splendor sticky-top">
  <div class="container">
    <!-- Logo -->
<a class="navbar-brand d-flex align-items-center me-3" href="/">
  <img
    src="/public/logo.png"
    alt="Agua Amazonica"
    class="logo-img"
    width="72"
    height="72"
  />
</a>

    <button
      class="navbar-toggler"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarNav"
      aria-controls="navbarNav"
      aria-expanded="false"
      aria-label="Toggle navigation"
    >
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarNav">
      <!-- Menú pegado al logo (sin mx-auto) -->
      <ul class="navbar-nav me-auto mb-2 mb-lg-0">
        {navItems.map((item) => (
          <li class="nav-item">
            <a class="nav-link" href={item.href}>{item.name}</a>
          </li>
        ))}
      </ul>

      <!-- Botón a la derecha -->
      <a href="https://www.aguasplendor.com.ec/shop/" class="btn btn-tienda" target="_blank">
        Tienda en Línea
      </a>
    </div>
  </div>
</nav>