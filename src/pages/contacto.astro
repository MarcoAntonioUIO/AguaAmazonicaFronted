---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Contáctanos | Agua Amazonica">
  <section class="contact-section">
    <div class="container">
      <div class="row align-items-center min-vh-80 py-5">
        
        <!-- Columna izquierda: Texto + Contacto -->
        <div class="col-lg-4 order-2 order-lg-1">
          <div class="contact-info">
            <h1 class="contact-title">
              Nos gusta<br />
              saber de ti<br />
              <span>Contáctanos.</span>
            </h1>

            <ul class="contact-list list-unstyled mt-4">
              <li>
                <a href="tel:+593983192467">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                  </svg>
                  098 319 2467
                </a>
              </li>
              <li>
                <a href="mailto:carlos.omar@aguaamazonas.com.ec">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                    <polyline points="22,6 12,13 2,6"/>
                  </svg>
                  carlos.omar@aguaamazonas.com.ec
                </a>
              </li>
              <li>
                <a href="https://maps.app.goo.gl/PHfAXUgrpPn3G3Gp6" target="_blank" rel="noopener">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                    <circle cx="12" cy="10" r="3"/>
                  </svg>
                  Av. Quito y Río Napo, junto al parque <br />
                  <span class="ms-4">El Coca, Ecuador</span>
                </a>
              </li>
              <li>
               <!-- mas Sucursales
                <a href="https://maps.app.goo.gl/Ys4H4FxpwXBvdKzN9" target="_blank" rel="noopener">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                    <circle cx="12" cy="10" r="3"/>
                  </svg>
                  La Maná Km 5 1/2 vía La Maná<br />
                  <span class="ms-4">Estero Hondo – Cotopaxi, Ecuador</span>
                </a> -->
              </li>
            </ul>

            <!-- Redes sociales -->
            <div class="social-links mt-4">
              <a href="#" aria-label="Instagram" class="social-btn">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
              </a>
              <a href="#" aria-label="Facebook" class="social-btn">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
              </a>
              <a href="#" aria-label="TikTok" class="social-btn">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-5.2 1.74 2.89 2.89 0 012.31-4.64 2.93 2.93 0 01.88.13V9.4a6.84 6.84 0 00-1-.05A6.33 6.33 0 005 20.1a6.34 6.34 0 0010.86-4.43v-7a8.16 8.16 0 004.77 1.52v-3.4a4.85 4.85 0 01-1-.1z"/></svg>
              </a>
              <a href="#" aria-label="LinkedIn" class="social-btn">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
              </a>
            </div>
          </div>
        </div>

        <!-- Columna centro: Botellas con parallax -->
        <div class="col-lg-4 order-1 order-lg-2 text-center position-relative bottles-wrapper">
          <div class="bottles-container" id="bottlesParallax">
            <img
              src="/public/botella500ml-removebg-preview.png"
              alt="Botella Amazonica sin gas"
              class="bottle bottle-1"
              id="bottle1"
            />
            <img
              src="/public/botella500ml-removebg-preview.png"
              alt="Botella Amazonica con gas"
              class="bottle bottle-2"
              id="bottle2"
            />
          </div>
        </div>

        <!-- Columna derecha: Formulario -->
        <div class="col-lg-4 order-3">
          <form class="contact-form" id="contactForm">
            <div class="mb-3">
              <label for="nombre" class="form-label">Nombre y Apellido *</label>
              <input type="text" class="form-control" id="nombre" placeholder="Tu nombre" required />
            </div>

            <div class="mb-3">
              <label for="email" class="form-label">Email *</label>
              <input type="email" class="form-control" id="email" placeholder="jhon@gmail.com" required />
            </div>

            <div class="mb-3">
              <label for="telefono" class="form-label">Número de teléfono *</label>
              <input type="tel" class="form-control" id="telefono" placeholder="(593) 99 999 9999" required />
            </div>

            <div class="mb-3">
              <label for="mensaje" class="form-label">¿Cómo te podemos ayudar? *</label>
              <textarea class="form-control" id="mensaje" rows="4" placeholder="Cuéntanos un poco cómo te podemos ayudar" required></textarea>
            </div>

            <div class="mb-4">
              <label class="form-label d-block">¿Dónde nos has visto?</label>
              <div class="d-flex flex-wrap gap-3">
                <div class="form-check">
                  <input class="form-check-input" type="radio" name="origen" id="linkedin" value="LinkedIn" />
                  <label class="form-check-label" for="linkedin">LinkedIn</label>
                </div>
                <div class="form-check">
                  <input class="form-check-input" type="radio" name="origen" id="tiktok" value="TikTok" />
                  <label class="form-check-label" for="tiktok">TikTok</label>
                </div>
                <div class="form-check">
                  <input class="form-check-input" type="radio" name="origen" id="instagram" value="Instagram" />
                  <label class="form-check-label" for="instagram">Instagram</label>
                </div>
                <div class="form-check">
                  <input class="form-check-input" type="radio" name="origen" id="facebook" value="Facebook" />
                  <label class="form-check-label" for="facebook">Facebook</label>
                </div>
                <div class="form-check">
                  <input class="form-check-input" type="radio" name="origen" id="otro" value="Otro" />
                  <label class="form-check-label" for="otro">Otro</label>
                </div>
              </div>
            </div>

            <button type="submit" class="btn btn-enviar w-100">
              Enviar
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  .contact-section {
    background: #ffffff;
    overflow: hidden;
    position: relative;
  }

  .min-vh-80 {
    min-height: 80vh;
  }

  /* Título */
  .contact-title {
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    font-weight: 800;
    color: #1e293b;
    line-height: 1.15;
    letter-spacing: -0.5px;
  }

  .contact-title span {
    color: var(--splendor-blue);
  }

  /* Lista de contacto */
  .contact-list li {
    margin-bottom: 1.1rem;
  }

  .contact-list a {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    color: #334155;
    text-decoration: none;
    font-size: 0.95rem;
    line-height: 1.45;
    transition: color 0.2s;
  }

  .contact-list a:hover {
    color: var(--splendor-blue);
  }

  .contact-list svg {
    flex-shrink: 0;
    margin-top: 2px;
    color: var(--splendor-blue);
  }

  /* Redes sociales */
  .social-links {
    display: flex;
    gap: 0.6rem;
  }

  .social-btn {
    width: 38px;
    height: 38px;
    background: var(--splendor-blue);
    color: white;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.25s ease;
  }

  .social-btn:hover {
    background: var(--splendor-dark-blue);
    transform: translateY(-2px);
  }

  /* ===== BOTELLAS CON PARALLAX ===== */
  .bottles-wrapper {
    height: 520px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .bottles-container {
    position: relative;
    width: 100%;
    max-width: 340px;
    height: 280px;
  }

  .bottle {
    position: absolute;
    width: auto;
    max-height: 420px;
    filter: drop-shadow(0 20px 40px rgba(0, 60, 150, 0.25));
    transition: transform 0.1s ease-out;
    will-change: transform;
  }

  .bottle-1 {
    left: 0;
    top: 20px;
    z-index: 2;
    height: 400px;
  }

  .bottle-2 {
    right: 0;
    bottom: 10px;
    z-index: 1;
    height: 360px;
  }

  /* Formulario */
  .contact-form .form-label {
    font-weight: 600;
    font-size: 0.9rem;
    color: #1e293b;
    margin-bottom: 0.4rem;
  }

  .contact-form .form-control {
    border: 1.5px solid #cbd5e1;
    border-radius: 0.6rem;
    padding: 0.7rem 1rem;
    font-size: 0.95rem;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .contact-form .form-control:focus {
    border-color: var(--splendor-blue);
    box-shadow: 0 0 0 3px rgba(0, 86, 179, 0.12);
  }

  .form-check-label {
    font-size: 0.9rem;
    color: #475569;
  }

  .btn-enviar {
    background: var(--splendor-blue);
    color: white;
    border: none;
    border-radius: 50px;
    padding: 0.85rem 1.5rem;
    font-weight: 700;
    font-size: 1rem;
    transition: all 0.25s ease;
  }

  .btn-enviar:hover {
    background: var(--splendor-dark-blue);
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(0, 86, 179, 0.25);
  }

  /* Responsive */
  @media (max-width: 991px) {
    .bottles-wrapper {
      height: 380px;
      margin: 2rem 0;
    }
    .bottle-1 { height: 300px; }
    .bottle-2 { height: 270px; }
  }
</style>

<script>
  // Efecto parallax de las botellas al hacer scroll
  const bottle1 = document.getElementById('bottle1');
  const bottle2 = document.getElementById('bottle2');

  function handleParallax() {
    const scrollY = window.scrollY;
    const speed1 = 0.15;  // velocidad botella izquierda
    const speed2 = 0.25;  // velocidad botella derecha (más rápida)

    if (bottle1 && bottle2) {
      // Movimiento opuesto para efecto más dinámico
      bottle1.style.transform = `translateY(${scrollY * speed1}px) rotate(-2deg)`;
      bottle2.style.transform = `translateY(${-scrollY * speed2}px) rotate(3deg)`;
    }
  }

  // Usamos requestAnimationFrame para suavidad
  let ticking = false;
  window.addEventListener('scroll', () => {
    if (!ticking) {
      window.requestAnimationFrame(() => {
        handleParallax();
        ticking = false;
      });
      ticking = true;
    }
  });

  // Ejecutar una vez al cargar
  handleParallax();
</script>