---
import MainLayout from '../layouts/MainLayout.astro';

// Noticias y artículos destacados sobre agua y salud en Ecuador - 2026
const posts = [
  {
    title: "Agua potable en Ecuador: el desafío de garantizar calidad y cobertura",
    excerpt:
      "Una evaluación nacional de los servicios de agua potable y saneamiento evidenció importantes desafíos en calidad, cobertura y reducción de pérdidas de agua en Ecuador.",
    date: "26/02/2026",
    category: "Agua en Ecuador",
    image: "/images/blog/agua-calidad-ecuador.jpg",
    slug: "agua-potable-calidad-ecuador-2026",
    url: "https://www.regulacionagua.gob.ec/el-gobierno-nacional-evaluo-los-servicios-de-agua-potable-y-saneamiento-de-los-gad-71-de-la-poblacion-aun-no-recibe-agua-con-estandares-de-calidad/",
    external: true,
  },
  {
    title: "Quito recupera una fuente de abastecimiento de agua potable",
    excerpt:
      "La recuperación de la captación Blanco Chico permitirá reincorporar 700 litros por segundo al Sistema Papallacta Integrado y fortalecer el abastecimiento de agua potable de Quito.",
    date: "18/06/2026",
    category: "Agua potable",
    image: "/images/blog/agua-quito-papallacta.jpg",
    slug: "agua-potable-quito-papallacta-2026",
    url: "https://quitoinforma.quito.gob.ec/2026/06/18/quito-recuperara-fuente-de-abastecimiento-de-agua-potable-que-permanecio-fuera-de-operacion-durante-cinco-anos/",
    external: true,
  },
  {
    title: "Montecristi impulsa un nuevo sistema de agua potable para 160.000 habitantes",
    excerpt:
      "Un proyecto de aproximadamente USD 32 millones busca mejorar el abastecimiento de agua potable de Montecristi y responder al crecimiento poblacional proyectado hasta 2042.",
    date: "08/08/2026",
    category: "Infraestructura",
    image: "/images/blog/montecristi-agua.jpg",
    slug: "montecristi-proyecto-agua-potable-2026",
    url: "https://www.eluniverso.com/noticias/ecuador/montecristi-recibe-primer-desembolso-de-la-caf-para-proyecto-de-agua-potable-con-proyeccion-a-2042-nota/",
    external: true,
  },
  {
    title: "Calderón recupera progresivamente el suministro de agua potable",
    excerpt:
      "Una rotura de tubería afectó a quince sectores de Calderón. El servicio fue restablecido progresivamente mientras se realizaron trabajos de reparación y abastecimiento mediante tanqueros.",
    date: "10/09/2026",
    category: "Actualidad",
    image: "/images/blog/agua-calderon.jpg",
    slug: "agua-potable-calderon-2026",
    url: "https://www.eluniverso.com/noticias/ecuador/quito-ecuador-agua-potable-agua-potable-en-calderon-cortes-de-agua-potable-en-calderon-suministro-de-agua-potable-en-calderon-cuatro-dias-sin-el-servicio-en-calderon-nota/",
    external: true,
  },
  {
    title: "Salud renal en Ecuador: el IESS mantiene atención para pacientes de diálisis",
    excerpt:
      "El IESS informó pagos por USD 111,8 millones a prestadores externos de diálisis entre diciembre de 2025 y agosto de 2026, en el marco de la atención a pacientes renales.",
    date: "16/09/2026",
    category: "Salud renal",
    image: "/images/blog/salud-renal.jpg",
    slug: "salud-renal-dialisis-ecuador-2026",
    url: "https://www.eluniverso.com/noticias/ecuador/iess-paga-1118-millones-a-dializadoras-en-ecuador-nota/",
    external: true,
  },
];
---

<MainLayout title="Blog | Agua Amazónica">
  <!-- Hero del Blog -->
  <section class="blog-hero">
    <div class="blog-hero-overlay"></div>

    <div class="container position-relative">
      <div class="row min-vh-50 align-items-center py-5">
        <div class="col-lg-7">
          <h1 class="blog-hero-title mb-3">Blog</h1>

          <p class="blog-hero-subtitle">
            “La voz de nuestra comunidad y el poder del agua pura”
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Grid de posts -->
  <section class="blog-grid py-5">
    <div class="container">

      <div class="row g-4">

        {posts.map((post) => (
          <div class="col-md-6 col-lg-4">

            <article class="blog-card h-100">

              <!-- Imagen -->
              <div class="blog-card-image">

                <img
                  src={post.image}
                  alt={post.title}
                  class="img-fluid"
                  loading="lazy"
                  onerror="this.src='https://placehold.co/600x400/0056b3/ffffff?text=Agua+Amazonica'"
                />

                <span class="blog-card-category">
                  {post.category}
                </span>

              </div>

              <!-- Contenido -->
              <div class="blog-card-body">

                <time class="blog-card-date">
                  {post.date}
                </time>

                <h2 class="blog-card-title">

                  <a
                    href={post.url}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {post.title}
                  </a>

                </h2>

                <p class="blog-card-excerpt">
                  {post.excerpt}
                </p>

                <!-- Enlace -->
                <a
                  href={post.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="blog-card-link"
                >
                  Leer noticia

                  <svg
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path d="M5 12h14M12 5l7 7-7 7" />
                  </svg>

                </a>

              </div>

            </article>

          </div>
        ))}

      </div>

    </div>
  </section>
</MainLayout>

<style>
  /* ===== BLOG HERO ===== */

  .blog-hero {
    position: relative;
    background: linear-gradient(
      135deg,
      #004a9f 0%,
      #0070d4 100%
    );

    background-image: url('/public/FBIW12.jpg');

    background-size: cover;
    background-position: center;

    color: white;

    min-height: 420px;

    display: flex;
    align-items: center;
  }

  .blog-hero-overlay {
    position: absolute;
    inset: 0;

    background: linear-gradient(
      90deg,
      rgba(0, 40, 90, 0.85) 0%,
      rgba(0, 70, 150, 0.55) 100%
    );
  }

  .blog-hero-title {
    font-size: clamp(2.8rem, 6vw, 4.2rem);

    font-weight: 800;

    line-height: 1.1;

    letter-spacing: -1px;
  }

  .blog-hero-subtitle {
    font-size: 1.35rem;

    font-weight: 400;

    opacity: 0.95;

    max-width: 520px;

    font-style: italic;
  }

  /* ===== BLOG GRID ===== */

  .blog-grid {
    background: #f8fafc;
  }

  .blog-card {
    background: white;

    border-radius: 1rem;

    overflow: hidden;

    box-shadow:
      0 4px 20px rgba(0, 0, 0, 0.06);

    transition: all 0.3s ease;

    display: flex;

    flex-direction: column;
  }

  .blog-card:hover {
    transform: translateY(-6px);

    box-shadow:
      0 12px 32px rgba(0, 86, 179, 0.15);
  }

  /* ===== IMAGEN ===== */

  .blog-card-image {
    position: relative;

    height: 220px;

    overflow: hidden;
  }

  .blog-card-image img {
    width: 100%;

    height: 100%;

    object-fit: cover;

    transition: transform 0.4s ease;
  }

  .blog-card:hover .blog-card-image img {
    transform: scale(1.05);
  }

  /* ===== CATEGORÍA ===== */

  .blog-card-category {
    position: absolute;

    top: 1rem;

    right: 1rem;

    background: #f59e0b;

    color: white;

    font-size: 0.75rem;

    font-weight: 600;

    padding: 0.3rem 0.85rem;

    border-radius: 50px;
  }

  /* ===== BODY ===== */

  .blog-card-body {
    padding: 1.5rem;

    display: flex;

    flex-direction: column;

    flex-grow: 1;
  }

  .blog-card-date {
    font-size: 0.85rem;

    color: #64748b;

    margin-bottom: 0.6rem;

    display: block;
  }

  .blog-card-title {
    font-size: 1.15rem;

    font-weight: 700;

    line-height: 1.35;

    margin-bottom: 0.75rem;
  }

  .blog-card-title a {
    color: #1e293b;

    text-decoration: none;

    transition: color 0.2s;
  }

  .blog-card-title a:hover {
    color: var(--splendor-blue);
  }

  .blog-card-excerpt {
    font-size: 0.92rem;

    color: #64748b;

    line-height: 1.55;

    margin-bottom: 1.25rem;

    flex-grow: 1;
  }

  /* ===== ENLACE ===== */

  .blog-card-link {
    display: inline-flex;

    align-items: center;

    gap: 0.4rem;

    color: var(--splendor-blue);

    font-weight: 600;

    font-size: 0.9rem;

    text-decoration: none;

    transition: gap 0.2s;
  }

  .blog-card-link:hover {
    gap: 0.7rem;

    color: var(--splendor-dark-blue);
  }

  /* ===== RESPONSIVE ===== */

  @media (max-width: 768px) {

    .blog-hero {
      min-height: 360px;
    }

    .blog-card-image {
      height: 210px;
    }

  }
</style>